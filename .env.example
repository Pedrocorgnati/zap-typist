# ============================================
# ZAP TYPIST — ARQUIVO DE AMBIENTE (EXEMPLO)
# ============================================
# Copie este arquivo para .env e preencha os valores
# Este arquivo é versionado; .env é ignorado pelo git
# Gerado por: /env-creation em 2026-05-04

# ────────────────────────────────────────────
# APLICAÇÃO
# ────────────────────────────────────────────
# Nível de log: DEBUG, INFO, WARNING, ERROR
ZAP_TYPIST_LOG_LEVEL=INFO

# Ativa modo desenvolvedor (mostra debug na barra de status)
ZAP_TYPIST_DEV_MODE=false

# Ativa logs detalhados do logger
DEBUG=false

# ────────────────────────────────────────────
# DATA E CACHE
# ────────────────────────────────────────────
# Caminho alternativo para dados (opcional)
# Se vazio, usa ~/.local/share/zap-typist
ZAP_TYPIST_DATA_DIR=./data

# ────────────────────────────────────────────
# NAVEGADOR
# ────────────────────────────────────────────
# Caminho para Chrome/Chromium (opcional, auto-detecta se vazio)
# Exemplos:
#   Linux: /usr/bin/google-chrome
#   macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Windows: C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
ZAP_TYPIST_CHROME_BIN=/usr/bin/google-chrome

# ────────────────────────────────────────────
# BANCO DE DADOS
# ────────────────────────────────────────────
# String de conexão SQLite para armazenar dados
DATABASE_URL=sqlite:///./zap_typist.db

# ────────────────────────────────────────────
# TESTES (opcional)
# ────────────────────────────────────────────
# Fator de tolerancia de performance em testes
# Default: 1.0. Use 2.0 para máquinas lentas.
# PERF_TOLERANCE_FACTOR=1.0
